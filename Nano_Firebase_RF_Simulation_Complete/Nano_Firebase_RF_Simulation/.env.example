# Copy this file to .env, fill it in, and never commit the filled .env.
# Firebase Console > Build > Realtime Database (root HTTPS URL)
FIREBASE_DATABASE_URL=https://YOUR-DATABASE-REGION.firebasedatabase.app
# Firebase Console > Project Settings > Your apps > Web API key
FIREBASE_API_KEY=YOUR_WEB_API_KEY

# Firebase Console > Authentication > Users: create two users.
FIREBASE_PUBLISHER_EMAIL=publisher@example.com
FIREBASE_PUBLISHER_PASSWORD=CHANGE_ME
FIREBASE_VIEWER_EMAIL=viewer@example.com
FIREBASE_VIEWER_PASSWORD=CHANGE_ME
